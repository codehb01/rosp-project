# Only the optional AI settings are listed here. Core variables (database, Clerk,
# Razorpay, Cloudinary) are in the README under "Environment Setup".

# ---- AI assistant (optional, off by default) ----
AI_ENABLED=false

# Primary LLM: any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Optional fallback LLM
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Embeddings (semantic search)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
